    {
      "id": "a25e1616-476b-5dd0-8048-0d2641c96502",
      "name": "Sticky Note 7",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1540,
        940
      ],
      "parameters": {
        "content": "## 6. Mark removed, rescore, sync\n**Mark removed** sets `source_removed` (and clears `active`) on the row. If it was the active **CV**, every job's score belongs to a CV that is gone: jobs go back to `pending` with their score, explanation, breakdown and basis cleared (a job being scored right now, claimed less than 5 minutes ago, is left alone; its save is thrown away by *Job match scoring* because the basis changed). Ignored extra files do not affect scores.\n**Trigger documents sync** then lets the next file (if any) take over. Answers `204`.",
        "height": 460,
        "width": 800,
        "color": 5
      }
    },
    {
      "id": "b5206158-d99e-53a3-83ba-edaa9f9762a8",
      "name": "Mark removed and reset scores",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1560,
        1200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Parameters: [1] owner, [2] document id, [3] true when the deleted document was the active CV\nwith marked as (\n  update base_documents\n  set source_removed = true, active = false, updated_at = now()\n  where owner_id = $1 and id = $2\n  returning id\n),\nreset as (\n  update jobs\n  set score_status = 'pending', score_attempts = 0, score_claimed_at = null,\n      match_score = null, match_explanation = null, match_breakdown = null, match_basis_hash = null,\n      updated_at = now()\n  where owner_id = $1 and $3::boolean\n    and not (score_status = 'in_progress' and score_claimed_at >= now() - interval '5 minutes')\n  returning id\n)\nselect (select count(*) from marked) as marked, (select count(*) from reset) as jobs_reset;",
        "options": {
          "queryReplacement": "={{ [ '00000000-0000-0000-0000-000000000001', $('Find document').first().json.id, $('Find document').first().json.kind === 'cv' && $('Find document').first().json.active ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "jh-postgres",
          "name": "JobHunter Postgres"
        }
      }
    },
