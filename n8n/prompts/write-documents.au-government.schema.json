            "properties": {
              "name": {
                "type": "string"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "competencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverLetter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "addressee",
        "salutation",
        "paragraphs",
        "signOff",
        "name"
