            "type": "object",
            "additionalProperties": false,
            "required": [
              "group",
              "items"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "experience": {
          "type": "array",
          "items": {
