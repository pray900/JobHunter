    "criteriaCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "answeredIn",
          "why"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "answeredIn": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
