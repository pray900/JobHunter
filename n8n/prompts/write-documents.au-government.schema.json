{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templateId",
    "templateReason",
    "cv",
    "coverLetter",
    "keywordCoverage",
    "changes",
    "stretches",
    "criteriaCoverage"
  ],
  "properties": {
