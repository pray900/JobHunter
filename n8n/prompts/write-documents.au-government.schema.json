            "additionalProperties": false,
            "required": [
              "title",
              "employer",
              "location",
              "dates",
              "bullets",
              "achievements"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "employer": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "dates": {
                "type": "string"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "achievements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "qualification",
              "institution",
              "dates",
              "statusText"
            ],
            "properties": {
              "qualification": {
                "type": "string"
              },
              "institution": {
                "type": "string"
              },
              "dates": {
                "type": "string"
              },
              "statusText": {
                "type": "string"
              }
            }
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "bullets"
